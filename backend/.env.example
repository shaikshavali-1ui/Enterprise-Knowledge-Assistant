# Server Port
PORT=5000

# Security Clearance JWT Secret Key
JWT_SECRET=enterprise_rag_secret_key_2026_super_secure

# ----------------------------------------------------
# REAL-WORLD GMAIL SMTP CREDENTIALS SETUP
# ----------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Generate a 16-character App Password (myaccount.google.com/apppasswords)
# 3. Fill in your Gmail address and 16-character App Password below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM_NAME=Enterprise Knowledge Assistant
SMTP_FROM_EMAIL=yourgmail@gmail.com

# ----------------------------------------------------
# VECTOR DATABASE & RAG CREDENTIALS (OPTIONAL)
# ----------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=enterprise-docs
OPENAI_API_KEY=your_openai_api_key
